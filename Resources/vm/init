#!/bin/busybox sh
# OmniFS guest init: mounts the attached partition (/dev/vda) with the Linux kernel driver
# and shares it with macOS over SMB, or checks and repairs it. Talks to omnifs-vmd over the console (hvc0):
#   guest -> host: OMNIFS_WANT_NAME | OMNIFS_WANT_SECRET | OMNIFS_READY ip=<addr> export=<share name>
#                  | OMNIFS_REPAIRED <summary> | OMNIFS_ERROR <message> | OMNIFS_STOPPED
#   host -> guest: <volume name>, <share password> (answering the WANT lines), then "shutdown"
# Kernel command line: omnifs.fs=<ntfs|ext2|ext3|ext4|btrfs|xfs|zfs|f2fs|udf> omnifs.ro=<0|1>
#                      omnifs.action=<mount|repair> omnifs.mkfs=<0|1> (test images only)

/bin/busybox --install -s
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /run
ln -sfn /run /var/run
# A resolvable hostname: Samba looks its own name up during every connection setup, and without one (there is
# no DNS here) each lookup waits for a 5 s timeout, enough for the Mac to give up connecting
hostname omnifs
printf '127.0.0.1 localhost omnifs omnifs.local\n::1 localhost omnifs omnifs.local\n' >/etc/hosts
depmod -a
exec </dev/console >/dev/console 2>&1

fail() {
    echo "OMNIFS_ERROR $*"
    sync
    poweroff -f
}

load() { modprobe -q "$@"; }

arg() { tr ' ' '\n' </proc/cmdline | sed -n "s/^omnifs\.$1=//p"; }
[ "$(arg debug)" = "1" ] && set -x
FS=$(arg fs)
RO=$(arg ro)
ACTION=$(arg action)

load virtio_blk
load virtio_net
load virtio-rng
load af_packet

# Wait for the partition and network device to appear
for i in $(seq 50); do
    [ -b /dev/vda ] && [ -e /sys/class/net/eth0 ] && break
    sleep 0.1
done
[ -b /dev/vda ] || fail "partition device did not appear"

# ZFS keeps its cache in guest RAM; let it use half of the VM's memory
load_zfs() {
    arc=$(( $(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo) * 512 ))
    load zfs zfs_arc_max=$arc || fail "the ZFS kernel module could not be loaded"
}

# Imports the pool on /dev/vda with its datasets under /zfs; sets POOL
import_zfs_pool() {
    load_zfs
    POOL=$(zpool import -d /dev 2>/dev/null | sed -n 's/^ *pool: //p' | head -1)
    [ -n "$POOL" ] || fail "no importable ZFS pool found on this partition"
    set -- -d /dev -N -R /zfs
    [ "$RO" = "1" ] && set -- "$@" -o readonly=on
    if ! err=$(zpool import "$@" "$POOL" 2>&1); then
        # Pools moved from another computer without "zpool export" look in use; the disk is physically here
        case "$err" in
            *"another system"*) err=$(zpool import -f "$@" "$POOL" 2>&1) || fail "ZFS import failed: $err" ;;
            *) fail "ZFS import failed: $err" ;;
        esac
    fi
}

# Test images only: omnifs-vmd refuses --format for real devices. Btrfs and ZFS test volumes also get a
# subvolume / child dataset so tests can verify they are reachable.
if [ "$(arg mkfs)" = "1" ]; then
    mkdir -p /run/fmt
    case "$FS" in
        ext2|ext3|ext4) mke2fs -q -F -t "$FS" -L OMNIFS /dev/vda ;;
        ntfs) mkntfs -Q -F -q -L OMNIFS /dev/vda ;;
        xfs) mkfs.xfs -q -f -L OMNIFS /dev/vda ;;
        f2fs) mkfs.f2fs -q -f -l OMNIFS /dev/vda >/dev/null ;;
        udf) mkudffs --media-type=hd --label=OMNIFS /dev/vda >/dev/null ;;
        btrfs)
            load btrfs
            mkfs.btrfs -q -f -L OMNIFS /dev/vda && mount -t btrfs /dev/vda /run/fmt \
                && btrfs subvolume create /run/fmt/@home >/dev/null \
                && echo "inside a subvolume" >/run/fmt/@home/subvolume.txt && umount /run/fmt ;;
        zfs)
            load_zfs
            zpool create -f -O mountpoint=/OMNIFS OMNIFS /dev/vda && zfs create OMNIFS/child \
                && echo "inside a child dataset" >/OMNIFS/child/dataset.txt && zpool export OMNIFS ;;
        *) false ;;
    esac || fail "cannot format $FS"
fi

# ----- Check & repair -----
if [ "$ACTION" = "repair" ]; then
    echo "OMNIFS_LOG checking $FS volume"
    case "$FS" in
        ext2|ext3|ext4)
            e2fsck -f -y /dev/vda
            rc=$?
            case $rc in
                0) SUMMARY="No problems found." ;;
                1|2|3) SUMMARY="Problems were found and repaired." ;;
                *) fail "Problems remain that could not be repaired (e2fsck exit code $rc)." ;;
            esac ;;
        ntfs)
            ntfsfix -d /dev/vda || fail "ntfsfix could not repair this NTFS volume. Run chkdsk on Windows."
            SUMMARY="Basic NTFS repairs done and the volume marked clean. For a full check, run chkdsk on Windows." ;;
        xfs)
            xfs_repair /dev/vda
            rc=$?
            if [ $rc -eq 2 ]; then
                # The log must be replayed before repair; mounting does that
                load xfs
                mkdir -p /run/replay && mount -t xfs /dev/vda /run/replay && umount /run/replay
                xfs_repair /dev/vda
                rc=$?
            fi
            [ $rc -eq 0 ] || fail "xfs_repair could not repair this volume (exit code $rc)."
            SUMMARY="XFS check and repair completed; no problems remain." ;;
        f2fs)
            fsck.f2fs -f -y /dev/vda || fail "fsck.f2fs could not repair this volume."
            SUMMARY="F2FS check and repair completed; no problems remain." ;;
        btrfs)
            btrfs check --readonly /dev/vda || fail "Btrfs check found errors. Automatic Btrfs repair can lose data; mount the volume read-only to copy your files off, then use 'btrfs rescue' on Linux."
            SUMMARY="No problems found." ;;
        zfs)
            RO=0
            import_zfs_pool
            zpool scrub -w "$POOL" || { zpool export "$POOL"; fail "the ZFS scrub could not run"; }
            STATUS=$(zpool status -x "$POOL")
            echo "$STATUS"
            zpool export "$POOL"
            case "$STATUS" in
                *"is healthy"*) SUMMARY="Scrub completed; the pool is healthy." ;;
                *) fail "Scrub completed but the pool reports problems: $(echo "$STATUS" | sed -n 's/^ *status: //p')" ;;
            esac ;;
        *) fail "repair is not supported for '$FS'" ;;
    esac
    sync
    echo "OMNIFS_REPAIRED $SUMMARY"
    poweroff -f
fi

# ----- Mount and export -----

# Finder shows SMB volumes under their share name, so share under the volume's name (sent by omnifs-vmd),
# protected by a password that is only valid for this VM (also sent over the console, never on the command line)
echo "OMNIFS_WANT_NAME"
read -r VOLNAME
VOLNAME=$(echo "$VOLNAME" | tr -d '/"[]')
[ -n "$VOLNAME" ] || VOLNAME=volume
echo "OMNIFS_WANT_SECRET"
# The console echoes input, which would put the password in the helper's log
stty -echo 2>/dev/null
read -r SECRET
stty echo 2>/dev/null
[ -n "$SECRET" ] || fail "no share password received"
EXPORT="/exports/$VOLNAME"
mkdir -p "$EXPORT"
[ "$RO" = "1" ] && MODE=ro || MODE=rw

case "$FS" in
    ext2|ext3|ext4) load ext4; TYPE=ext4; OPTS="$MODE" ;;
    ntfs) load ntfs3; TYPE=ntfs3; OPTS="$MODE,windows_names,iocharset=utf8" ;;
    # The top level (subvolid 5) shows every subvolume and snapshot as a folder
    btrfs) load btrfs; TYPE=btrfs; OPTS="$MODE,subvolid=5" ;;
    xfs) load xfs; TYPE=xfs; OPTS="$MODE" ;;
    f2fs) load f2fs; TYPE=f2fs; OPTS="$MODE" ;;
    # Linux writes UDF up to revision 2.01; newer revisions are mounted read-only by the kernel
    udf) load udf; TYPE=udf; OPTS="$MODE,utf8" ;;
    zfs) TYPE=zfs ;;
    *) fail "unsupported filesystem '$FS'" ;;
esac

if [ "$TYPE" = "zfs" ]; then
    import_zfs_pool
    zfs mount -a || fail "could not mount the datasets of ZFS pool $POOL (encrypted datasets are not supported)"
    # Present the root dataset (or, if it is not mountable, everything under the pool) at the export path
    SRC=/zfs
    [ "$(zfs get -H -o value mounted "$POOL")" = "yes" ] && SRC=$(zfs get -H -o value mountpoint "$POOL")
    mount -o rbind "$SRC" "$EXPORT" || fail "could not present ZFS pool $POOL"
elif ! err=$(mount -t "$TYPE" -o "$OPTS" /dev/vda "$EXPORT" 2>&1); then
    if [ "$TYPE" = "ntfs3" ]; then
        fail "NTFS volume is marked dirty or in use by Windows (hibernation / Fast Startup). Use Check & Repair, or shut Windows down fully, then try again. ($err)"
    fi
    fail "mount failed: $err"
fi

# Network (Virtualization.framework NAT provides DHCP)
ip link set lo up
ip link set eth0 up
cat >/run/udhcpc.sh <<'EOF'
#!/bin/sh
[ "$1" = bound ] || [ "$1" = renew ] || exit 0
ip addr flush dev "$interface"
ip addr add "$ip/${mask:-24}" dev "$interface"
EOF
chmod +x /run/udhcpc.sh
udhcpc -i eth0 -s /run/udhcpc.sh -q -n -t 20 >/dev/null 2>&1 || fail "network configuration failed"
IP=$(ip -4 -o addr show eth0 | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p')

# SMB server: Samba with vfs_fruit, the configuration macOS clients are built for. macOS's SMB client handles
# locking itself and mounts through NetFS, so Finder can delete on these volumes. Everything is served as root so
# the Mac user can read and write the whole volume. (The in-kernel ksmbd was tried first: it marks a whole file
# delete-pending while one of its streams is deleted, breaking macOS copies, and refuses to rename folders whose
# files the Mac still holds open, breaking Finder renames.)
mkdir -p /etc/samba /run/samba/lock /run/samba/state /run/samba/cache /run/samba/private /var/log/samba
[ "$RO" = "1" ] && SHARE_RO=yes || SHARE_RO=no
[ "$(arg debug)" = "1" ] && LOGLEVEL=3 || LOGLEVEL=0
cat >/etc/samba/smb.conf <<EOF
[global]
    server role = standalone server
    netbios name = OMNIFS
    security = user
    map to guest = never
    passdb backend = tdbsam:/run/samba/private/passdb.tdb
    lock directory = /run/samba/lock
    state directory = /run/samba/state
    cache directory = /run/samba/cache
    private dir = /run/samba/private
    pid directory = /run/samba
    log file = /dev/console
    log level = $LOGLEVEL
    disable netbios = yes
    smb ports = 445
    server min protocol = SMB2_10
    load printers = no
    printcap name = /dev/null
    disable spoolss = yes
    # macOS client support: Mac metadata as named streams in xattrs (no ._ files), POSIX-style renames of
    # folders with open files, characters that are legal on macOS but not in SMB names
    vfs objects = catia fruit streams_xattr
    fruit:metadata = stream
    fruit:posix_rename = yes
    fruit:zero_file_id = yes
    fruit:nfs_aces = no
    fruit:veto_appledouble = no
    fruit:wipe_intentionally_left_blank_rfork = yes
    fruit:delete_empty_adfiles = yes
    ea support = yes
    # No SMB2 leases: with them the Mac reuses a file's lease key after its folder is renamed, which Samba rejects,
    # so writes to files in a just-renamed folder fail (EINVAL). Without them a folder rename can be refused for a
    # moment right after its files were used (the client is still closing them) and works when retried.
    smb2 leases = no
    # Performance: async I/O on every request, zero-copy reads
    use sendfile = yes
    aio read size = 1
    aio write size = 1
[$VOLNAME]
    path = $EXPORT
    read only = $SHARE_RO
$([ "$TYPE" = "udf" ] && printf '    # UDF has no extended attributes: no metadata streams, macOS keeps ._ files instead\n    vfs objects = catia\n    ea support = no')
    valid users = omnifs
    force user = root
    force group = root
EOF
printf '%s\n%s\n' "$SECRET" "$SECRET" | smbpasswd -c /etc/samba/smb.conf -s -a omnifs >/dev/null || fail "Samba user setup failed"
# The preload lets folders holding only the Mac's .smbdelete placeholders be deleted (see smbdelete-preload.c)
LD_PRELOAD=/usr/lib/omnifs-smbdelete.so smbd -s /etc/samba/smb.conf -D || fail "smbd failed to start"
for i in $(seq 50); do nc -z 127.0.0.1 445 2>/dev/null && break; sleep 0.1; done

echo "OMNIFS_READY ip=$IP export=$VOLNAME"

while read -r cmd; do
    [ "$cmd" = shutdown ] && break
done

killall smbd 2>/dev/null
sync
if [ "$TYPE" = "zfs" ]; then
    # Lazy unmount detaches the whole rbind tree at once (busybox umount has no -R)
    umount -l "$EXPORT"
    # Export so the pool imports cleanly on any other system
    zpool export "$POOL" || zpool export -f "$POOL"
else
    umount "$EXPORT" || umount -l "$EXPORT"
fi
sync
echo "OMNIFS_STOPPED"
poweroff -f
